{
  "schema_version": 1,
  "metadata": {
    "engine": "Python str re semantics; baseline CPython 3.7.7, compare native/WASM only at the same Python version",
    "flags": "Symbolic re names, combined with bitwise OR; no numeric ABI assumptions",
    "offsets": "Unicode code points, not UTF-8 bytes or JavaScript UTF-16 units; no normalization",
    "match_shape": "Match objects normalized to the listed fields; tuples become JSON arrays; unmatched groups are null and their regs are [-1, -1]",
    "errors": "Compare categories only, never interpreter exception wording",
    "adapter": "Legacy RegexService and GET API expectations are separate references/overrides; not engine requirements"
  },
  "engine_cases": [
    {"id": "match-groups", "operation": "match", "pattern": "(?P<word>a)(b)?", "input": "a!", "flags": [],
     "expected": {"group": "a", "groups": ["a", null], "group_dict": {"word": "a"}, "start": 0, "end": 1, "pos": 0, "span": [0, 1], "regs": [[0, 1], [0, 1], [-1, -1]], "last_group": "word", "last_index": 1}},
    {"id": "search-offset", "operation": "search", "pattern": "(?P<n>\\d+)", "input": "x12!", "flags": [],
     "expected": {"group": "12", "groups": ["12"], "group_dict": {"n": "12"}, "start": 1, "end": 3, "pos": 0, "span": [1, 3], "regs": [[1, 3], [1, 3]], "last_group": "n", "last_index": 1}},
    {"id": "match-not-search", "operation": "match", "pattern": "a", "input": "ba", "flags": [], "expected": null},
    {"id": "search-no-match", "operation": "search", "pattern": "z", "input": "abc", "flags": [], "expected": null},
    {"id": "findall-no-groups", "operation": "findall", "pattern": "\\d+", "input": "a12 b3", "flags": [], "expected": ["12", "3"]},
    {"id": "findall-one-group", "operation": "findall", "pattern": "a(\\d+)", "input": "a12 a3", "flags": [], "expected": ["12", "3"]},
    {"id": "findall-many-groups", "operation": "findall", "pattern": "(?P<letter>a)(b)?", "input": "ab a", "flags": [], "expected": [["a", "b"], ["a", ""]]},
    {"id": "findall-no-match", "operation": "findall", "pattern": "z", "input": "abc", "flags": [], "expected": []},
    {"id": "empty-match", "operation": "match", "pattern": "", "input": "", "flags": [],
     "expected": {"group": "", "groups": [], "group_dict": {}, "start": 0, "end": 0, "pos": 0, "span": [0, 0], "regs": [[0, 0]], "last_group": null, "last_index": null}},
    {"id": "empty-search", "operation": "search", "pattern": "", "input": "abc", "flags": [],
     "expected": {"group": "", "groups": [], "group_dict": {}, "start": 0, "end": 0, "pos": 0, "span": [0, 0], "regs": [[0, 0]], "last_group": null, "last_index": null}},
    {"id": "empty-findall", "operation": "findall", "pattern": "", "input": "", "flags": [], "expected": [""]},
    {"id": "empty-pattern-boundaries", "operation": "findall", "pattern": "", "input": "ab", "flags": [], "expected": ["", "", ""]},
    {"id": "empty-input-no-match", "operation": "findall", "pattern": "a", "input": "", "flags": [], "expected": []},
    {"id": "zero-length-search", "operation": "search", "pattern": "(?=b)", "input": "ab", "flags": [],
     "expected": {"group": "", "groups": [], "group_dict": {}, "start": 1, "end": 1, "pos": 0, "span": [1, 1], "regs": [[1, 1]], "last_group": null, "last_index": null}},
    {"id": "empty-then-nonempty", "operation": "findall", "pattern": "|a", "input": "a", "flags": [], "expected": ["", "a", ""]},
    {"id": "ignorecase", "operation": "findall", "pattern": "é", "input": "É é", "flags": ["IGNORECASE"], "expected": ["É", "é"]},
    {"id": "multiline", "operation": "findall", "pattern": "^a$", "input": "a\nb\na", "flags": ["MULTILINE"], "expected": ["a", "a"]},
    {"id": "dotall", "operation": "findall", "pattern": "a.b", "input": "a\nb", "flags": ["DOTALL"], "expected": ["a\nb"]},
    {"id": "verbose", "operation": "findall", "pattern": "a \\s+ b # comment", "input": "a b ab", "flags": ["VERBOSE"], "expected": ["a b"]},
    {"id": "unicode", "operation": "findall", "pattern": "\\w+", "input": "café 😀", "flags": ["UNICODE"], "expected": ["café"]},
    {"id": "combined-im", "operation": "findall", "pattern": "^a$", "input": "A\na", "flags": ["IGNORECASE", "MULTILINE"], "expected": ["A", "a"]},
    {"id": "combined-sx", "operation": "findall", "pattern": "a . b # comment", "input": "a\nb", "flags": ["DOTALL", "VERBOSE"], "expected": ["a\nb"]},
    {"id": "unicode-offsets", "operation": "search", "pattern": "(?P<accent>é)(😀)(é)", "input": "😀xé😀é!", "flags": [],
     "expected": {"group": "é😀é", "groups": ["é", "😀", "é"], "group_dict": {"accent": "é"}, "start": 2, "end": 6, "pos": 0, "span": [2, 6], "regs": [[2, 6], [2, 3], [3, 4], [4, 6]], "last_group": null, "last_index": 3}},
    {"id": "no-normalization", "operation": "search", "pattern": "é", "input": "é", "flags": [], "expected": null},
    {"id": "locale-str-rejected", "operation": "findall", "pattern": "\\w+", "input": "café", "flags": ["LOCALE"], "error": "invalid_flags"},
    {"id": "invalid-bracket", "operation": "search", "pattern": "[", "input": "", "flags": [], "error": "invalid_pattern"},
    {"id": "invalid-group-name", "operation": "match", "pattern": "(?P<1>a)", "input": "a", "flags": [], "error": "invalid_pattern"}
  ],
  "adapter_cases": [
    {"engine_case": "match-groups", "expectation": "engine"},
    {"engine_case": "search-offset", "expectation": "engine"},
    {"engine_case": "match-not-search", "expectation": "engine"},
    {"engine_case": "search-no-match", "expectation": "engine"},
    {"engine_case": "findall-no-groups", "expectation": "engine"},
    {"engine_case": "findall-one-group", "expectation": "engine"},
    {"engine_case": "findall-many-groups", "expectation": "engine"},
    {"engine_case": "findall-no-match", "expectation": "override", "expected": null, "quirk": "empty-findall-is-null"},
    {"engine_case": "empty-match", "expectation": "engine"},
    {"engine_case": "empty-search", "expectation": "engine"},
    {"engine_case": "empty-findall", "expectation": "engine"},
    {"engine_case": "empty-pattern-boundaries", "expectation": "engine"},
    {"engine_case": "empty-input-no-match", "expectation": "override", "expected": null, "quirk": "empty-findall-is-null"},
    {"engine_case": "zero-length-search", "expectation": "engine"},
    {"engine_case": "empty-then-nonempty", "expectation": "engine"},
    {"engine_case": "ignorecase", "expectation": "engine"},
    {"engine_case": "multiline", "expectation": "engine"},
    {"engine_case": "dotall", "expectation": "engine"},
    {"engine_case": "verbose", "expectation": "engine"},
    {"engine_case": "unicode", "expectation": "engine"},
    {"engine_case": "combined-im", "expectation": "engine"},
    {"engine_case": "combined-sx", "expectation": "engine"},
    {"engine_case": "unicode-offsets", "expectation": "engine"},
    {"engine_case": "no-normalization", "expectation": "engine"},
    {"engine_case": "locale-str-rejected", "expectation": "override", "api_status": 500, "quirk": "locale-error-is-500"},
    {"engine_case": "invalid-bracket", "expectation": "engine"},
    {"engine_case": "invalid-group-name", "expectation": "engine"},
    {"id": "invalid-operation", "operation": "not_an_operation", "pattern": "a", "input": "a", "flags": [], "error": "invalid_operation"}
  ],
  "quirks": {
    "locale-error-is-500": {
      "issue": "https://github.com/rscarvalho/pyregex/issues/47",
      "note": "FIXME #47: the UI exposes LOCALE, which Python 3 rejects for str. The API assumes every ValueError has service validation arguments and raises IndexError instead of returning a structured error. Characterize status only, not HTML or exception text."
    },
    "empty-findall-is-null": {
      "issue": "https://github.com/rscarvalho/pyregex/issues/47",
      "note": "FIXME #47: dict_from_object collapses the empty findall list to None. Preserve legacy adapter output here, not in the engine corpus."
    }
  }
}
